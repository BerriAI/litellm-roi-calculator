# Setup works entirely in the dashboard; this file is optional.
# Uncomment only fields you want to manage through your environment.
# Empty values are ignored and remain editable in the dashboard.
# LITELLM_GATEWAY_URL=http://localhost:4000
# Environment keys lock the destination URL; configure it above on the server.
# LITELLM_ADMIN_KEY=
# Optional: use a separate inference key for estimator requests.
# LITELLM_ESTIMATOR_KEY=
# LITELLM_ESTIMATOR_MODEL=
# GITHUB_TOKEN=
# An environment GitHub token also locks GITHUB_API_URL (defaults to github.com).
# GITHUB_REPOS=BerriAI/litellm
# GITHUB_API_URL=https://api.github.com
# Azure DevOps: GIT_PROVIDER=azure_devops selects Azure Repos; the PAT needs Code (Read).
# An environment AZURE_DEVOPS_PAT also locks AZURE_DEVOPS_ORG.
# GIT_PROVIDER=github
# AZURE_DEVOPS_ORG=
# AZURE_DEVOPS_PAT=
# GitLab: GIT_PROVIDER=gitlab selects GitLab (gitlab.com or self-managed); the PAT needs read_api.
# An environment GITLAB_PAT also locks GITLAB_URL.
# GITLAB_URL=https://gitlab.com
# GITLAB_PAT=
# Defaults to ~/.litellm-roi. Never commit this directory.
# ROI_DATA_DIR=.roi-data
# Hosting: the HTTPS origin; Render supplies RENDER_EXTERNAL_URL automatically.
# ROI_PUBLIC_URL=https://roi.example.com
# Optional existing GitHub App. The guided Connect GitHub flow configures these for you.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY=
